{
  "name": "graphite-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/main.ts",
    "build": "react-router build",
    "start": "node --disable-warning=ExperimentalWarning server/main.ts",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "node --env-file=server/test.env --disable-warning=ExperimentalWarning --test \"server/**/*.test.ts\" \"scripts/*.test.mjs\"",
    "size": "node scripts/check-size.mjs",
    "sync:releases": "node scripts/sync.mjs"
  },
  "dependencies": {
    "@hocuspocus/provider": "4.7.0",
    "@hocuspocus/server": "4.7.0",
    "@react-router/express": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-collaboration": "3.31.4",
    "@tiptap/extension-collaboration-caret": "3.31.4",
    "@tiptap/extension-details": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/extension-unique-id": "3.31.4",
    "@tiptap/extension-youtube": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/html": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "@tiptap/y-tiptap": "3.0.9",
    "ajv": "^8.20.0",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.3.1",
    "pino": "^10.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "y-protocols": "1.0.7",
    "yaml": "^2.9.1",
    "yjs": "13.6.33"
