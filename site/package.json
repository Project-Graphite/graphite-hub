{
  "name": "graphite-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/main.ts",
    "build": "react-router build",
    "start": "node --disable-warning=ExperimentalWarning server/main.ts",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "node --env-file=server/test.env --disable-warning=ExperimentalWarning --test \"server/**/*.test.ts\" \"scripts/*.test.mjs\"",
    "size": "node scripts/check-size.mjs",
    "sync:releases": "node scripts/sync.mjs"
  },
  "dependencies": {
    "@react-router/express": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "ajv": "^8.20.0",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.3.1",
    "pino": "^10.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.5.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.0.16"
  }
}
