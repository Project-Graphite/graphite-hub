---
import type { TopologyData } from '../types';

interface Props {
  topology: TopologyData;
  host: string;
}

const { topology, host } = Astro.props;

const BOX_W = 136;
const BOX_H = 58;
const GAP = 20;
const PAD = 10;
const INGRESS_H = 26;
const ROW_Y = 78;
const BUS_Y = ROW_Y + BOX_H + 20;
const DB_Y = BUS_Y + 22;
const DB_H = 26;

const MIN_W = 488;
const hasDatabase = topology.database !== 'none';
const count = topology.services.length;
const spanW = count * BOX_W + Math.max(count - 1, 0) * GAP;
const width = Math.max(spanW + PAD * 2, MIN_W);
const height = (hasDatabase ? DB_Y + DB_H : ROW_Y + BOX_H) + PAD;
const centre = width / 2;
const inset = (width - spanW) / 2;

const placed = topology.services.map((service, index) => ({
  ...service,
  x: inset + index * (BOX_W + GAP),
  cx: inset + index * (BOX_W + GAP) + BOX_W / 2,
}));

const routed = placed.filter((service) => service.route !== null);
const ingressW = Math.min(spanW, 260);
const elbowY = (INGRESS_H + ROW_Y) / 2;

const described = placed
  .map((service) => (service.route ? `${service.name} at ${service.route}` : `${service.name}, internal`))
  .join('; ');
---

<svg class="topology" viewBox={`0 0 ${width} ${height}`} role="img" preserveAspectRatio="xMidYMid meet">
  <title>{`${host}: ${described}${hasDatabase ? `; shared ${topology.database}` : ''}`}</title>

  {routed.length > 0 && (
    <Fragment>
      <rect class="pill" x={centre - ingressW / 2} y={0} width={ingressW} height={INGRESS_H} rx={INGRESS_H / 2} />
      <text class="pill-label" x={centre} y={17} text-anchor="middle">{host}</text>
      {routed.map((service) => (
        <path class="edge" d={`M ${centre} ${INGRESS_H} V ${elbowY} H ${service.cx} V ${ROW_Y}`} />
      ))}
    </Fragment>
  )}

  {hasDatabase && (
    <Fragment>
      {placed.map((service) => (
        <path class="edge soft" d={`M ${service.cx} ${ROW_Y + BOX_H} V ${BUS_Y}`} />
      ))}
      <path class="edge soft" d={`M ${placed[0].cx} ${BUS_Y} H ${placed[count - 1].cx}`} />
      <path class="edge soft" d={`M ${centre} ${BUS_Y} V ${DB_Y}`} />
      <rect class="pill" x={centre - 62} y={DB_Y} width={124} height={DB_H} rx={DB_H / 2} />
      <text class="pill-label" x={centre} y={DB_Y + 17} text-anchor="middle">{topology.database}</text>
    </Fragment>
  )}

  {placed.map((service) => (
    <Fragment>
      <rect
        class:list={['node', service.route === null && 'internal']}
        x={service.x}
        y={ROW_Y}
        width={BOX_W}
        height={BOX_H}
        rx={8}
      />
      <text class="node-name" x={service.cx} y={ROW_Y + 25} text-anchor="middle">{service.name}</text>
      <text class="node-meta" x={service.cx} y={ROW_Y + 43} text-anchor="middle">
        {service.route === null
          ? 'internal'
          : service.port === null
            ? service.route
            : `${service.route}  :${service.port}`}
      </text>
    </Fragment>
  ))}
</svg>

<style>
  .topology {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    overflow: visible;
  }

  .pill {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
  }

  .pill-label {
    fill: var(--muted);
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 11px;
  }

  .edge {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
  }

  .edge.soft {
    stroke: var(--line-soft);
    stroke-dasharray: 3 3;
  }

  .node {
    fill: var(--surface);
    stroke: var(--line);
    stroke-width: 1;
  }

  .node.internal {
    stroke-dasharray: 4 3;
  }

  .node-name {
    fill: var(--ink);
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 13px;
    font-weight: 500;
  }

  .node-meta {
    fill: var(--faint);
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 11px;
  }
</style>
